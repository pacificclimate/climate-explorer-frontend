  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "husky": "^9.0.11",
    "jsdom": "^30.0.1",
    "lint-staged": "^15.2.2",
    "prettier": "3.2.5",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "engines": {
    "node": "24.x",
    "npm": "12.x"
  },
  "allowScripts": {
    "core-js@2.6.12 || 3.45.1": true,
    "esbuild@0.25.12": true
