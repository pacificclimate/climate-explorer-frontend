  "scripts": {
    "reinstall": "npm ci",
    "start": "vite",
    "build": "APP_VERSION=$(bash ./generate-commitish.sh) vite build",
    "test": "vitest",
    "test:ci": "vitest run",
    "coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "prepare": "husky"
